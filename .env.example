# Folder penyimpanan file surat. Pakai folder yang tersinkron cloud supaya ter-backup
# dan bisa dibuka dari HP, mis.:
#   Google Drive for desktop (macOS): ~/Library/CloudStorage/GoogleDrive-<email>/My Drive/Arsip Surat
#   iCloud Drive (macOS):             ~/Library/Mobile Documents/com~apple~CloudDocs/Arsip Surat
# Kosongkan = otomatis iCloud Drive (kalau ada) atau folder data/ di project ini.
ARSIP_HOME=

# AI opsional untuk tombol "Ringkas dengan AI" (endpoint OpenAI-compatible).
# Kosongkan kalau tidak pakai AI — semua fitur tetap jalan tanpa AI.
AI_BASE_URL=http://localhost:8317/v1
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
